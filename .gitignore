# ----------------------------------------------------------------
# SECRETS & CREDENTIALS
# ----------------------------------------------------------------
# NEVER commit API keys or secret files.
# This explicitly matches your project's .env file.
config/.env
*.env
.env*

# ----------------------------------------------------------------
# PROJECT APEX - GENERATED DATA & CACHE
# ----------------------------------------------------------------
# Ignore all data generated by your orchestrator
data/
analysis/
audio/
output_data/

# Ignore the FastF1 cache and any local .pkl files
cache/
*.ff1pkl

# Ignore the generated manifest file
replay_manifest.json

# ----------------------------------------------------------------
# PYTHON
# ----------------------------------------------------------------
# Virtual environments
venv/
env/
.venv/
.env/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.tox/
.coverage
.coverage.*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ----------------------------------------------------------------
# UNITY
# ----------------------------------------------------------------
# Per-project temporary files
Library/
Temp/
Logs/
obj/

# Build artifacts
Build/
Builds/
UserSettings/

# Generated IDE/solution files
*.sln
*.csproj
*.user
*.userprefs

# ----------------------------------------------------------------
# IDE & EDITOR CONFIG
# ----------------------------------------------------------------
# VSCode
.vscode/

# PyCharm / IntelliJ
.idea/

# ----------------------------------------------------------------
# OPERATING SYSTEM FILES
# ----------------------------------------------------------------
# macOS
.DS_Store
._*
.AppleDouble

# Windows
Thumbs.db
desktop.ini